name: for testing pipeline # the name of the workflow, you can give it any name you want
# on: push # only fire this workflow automatically  on push

## the job will fire based on any new push or when the workflow is manually triggered from the Actions tab in the repo,
##so this means we can have multiple events for the same workflow
on: [push, workflow_dispatch] 

jobs:
  test-job: # the name of the job, you can give it any name you want
    runs-on: ubuntu-latest # the type of virtual host machine to run the job on
    steps: # any jobs can be implemented as a series of steps, each step is a single task that can run commands in a job
      - name: Get The Code # you should give the step a name to identify it in the workflow run logs
        uses: actions/checkout@v3 # this action checks out your repository under $GITHUB_WORKSPACE, so your workflow can access it
      - name: set nodejs version 
        uses: actions/setup-node@v7
        with: # with here describes the input parameters for the action as a configuration gateway
          node-version: 20
      - name: Install Dependencies
        run: npm install # this command will install all the dependencies listed in package.json (a bash command)
      - name: Run Tests
        run: npm test # this command will run the tests defined in your project (a bash command)
      # - name: Run Lint
      #   run: npm run lint # this command will run the linter defined in your project (a bash command)
  deploy-job:
    needs: test-job # this job will only run if the test-job is successful
    runs-on: ubuntu-latest #every job gets its runner - its own virtual machine that's totally isolated from other jobs.
    steps:
      - name: Get The Code
        uses: actions/checkout@v3
      - name: set nodejs version 
        uses: actions/setup-node@v7
        with:
          node-version: 20
      - name: Install Dependencies
        run: npm install 
      - name: Run Build
        run: npm run build
      - name: Deploy
        run: echo "Deploying..." 
      